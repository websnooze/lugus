{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lugus",
  "version": "0.1.1",
  "identifier": "com.websnooze.lugus",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Lugus",
        "width": 980,
        "height": 720,
        "minWidth": 840,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "hiddenTitle": true,
        "devtools": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Resources/Credits.rtf": "Credits.rtf"
      }
    },
    "resources": {
      "Assets.car": "Assets.car",
      "icons/tray-idle.png": "icons/tray-idle.png",
      "icons/tray-recording.png": "icons/tray-recording.png"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
